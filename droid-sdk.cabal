executable factory-droid-launcher
  main-is:         main.c
  hs-source-dirs:   native/process-launcher
  c-sources:       cbits/process-ipc.c
  include-dirs:    cbits
  cc-options:      -std=c11 -Wall -Wextra -Werror
  ghc-options:     -no-hs-main
  default-language: GHC2024

executable droid-ipc-test-peer
  scope:           private
  main-is:         ProcessIpcPeer.c
  hs-source-dirs:   test
  c-sources:       cbits/process-ipc.c
  include-dirs:    cbits
  cc-options:      -std=c11 -Wall -Wextra -Werror
  ghc-options:     -no-hs-main
  default-language: GHC2024

executable droid-example
  import:          warnings
  hs-source-dirs:  examples
  main-is:         Main.hs
  ghc-options:     -threaded -rtsopts
  build-depends:
    base >=4.21 && <4.22,
    droid-sdk,
    text >=2.1 && <2.2
