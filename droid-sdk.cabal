  build-depends:
    base >=4.21 && <4.22,
    aeson >=2.2.4 && <2.4,
    async >=2.2.5 && <2.3,
    base64-bytestring >=1.2.1 && <1.3,
    bytestring >=0.12.2 && <0.13,
    containers >=0.7 && <0.9,
    crypton >=1.0.4 && <1.2,
    crypton-connection >=0.4.6 && <0.5,
    data-default >=0.8 && <0.9,
