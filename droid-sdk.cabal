    http-client >=0.7.19 && <0.8,
    http-client-tls >=0.4 && <0.5,
    http-media >=0.8.1.1 && <0.9,
    http-types >=0.12.4 && <0.13,
    memory >=0.18 && <0.19,
    network >=3.2 && <3.3,
    network-uri >=2.6.4.2 && <2.7,
    process >=1.6.26.1 && <1.7,
    scientific >=0.3.8 && <0.4,
    stm >=2.5.3.1 && <2.6,
    text >=2.1 && <2.2,
    time >=1.12.2 && <1.13,
    tls >=2.3 && <2.5,
    unix >=2.8.7 && <2.9,
    uuid >=1.3.16 && <1.4,
    uuid-types >=1.0.6.1 && <1.1,
    vector >=0.13 && <0.14,
    wai >=3.2.4 && <3.3,
    warp >=3.4.7 && <3.5,
    websockets >=0.13 && <0.14

