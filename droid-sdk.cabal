cabal-version:      3.12
name:               droid-sdk
version:            0.1.0.0
synopsis:           Native Haskell SDK for Factory Droid
description:
  Native local Droid runs and existing-daemon sessions over verified TLS
  or explicit plaintext WebSockets. Shared text/event streams, validated
  attachments, typed output, cancellation and scoped cleanup; low-level
  RPC and wire codecs. Broader functional SDK coverage remains in progress;
  exhaustive schema reproduction is a separate backlog.
license:            Apache-2.0
license-file:       LICENSE
author:             John Wiegley
maintainer:         John Wiegley
category:           Network
build-type:         Simple
tested-with:        GHC ==9.12.4
extra-doc-files:
  README.md
  docs/parity.md
  docs/development.md
  docs/exhaustive-codec-backlog.md
  NOTICE
extra-source-files:
  .github/workflows/ci.yml
  cabal.project
  flake.nix
  flake.lock
  schema/manifest.json
  scripts/*.py
  cbits/process-ipc.h
  native/schema-validator/Cargo.toml
  native/schema-validator/Cargo.lock
  native/schema-validator/src/*.rs
  native/schema-validator/LICENSE
  native/schema-validator/THIRD_PARTY_LICENSES.txt
  native/schema-validator/licenses/*.txt
  native/schema-validator/VENDOR.md
  native/schema-validator/vendor/jsonschema/**/*.rs
  native/schema-validator/vendor/jsonschema/**/*.json
  native/schema-validator/vendor/jsonschema/**/*.toml
  native/schema-validator/vendor/jsonschema/**/*.md
  native/schema-validator/vendor/jsonschema/**/*.pem
  native/schema-validator/vendor/jsonschema/Cargo.toml.orig
  native/schema-validator/vendor/jsonschema/Cargo.lock
  native/schema-validator/vendor/jsonschema/LICENSE
data-files:
  schema/*.schema.json

common warnings
  default-language: GHC2024
  ghc-options:
    -Wall -Wcompat -Widentities
    -Wincomplete-uni-patterns -Wincomplete-record-updates

