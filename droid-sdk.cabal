    Factory.Droid.REST
    Factory.Droid.Retry
    Factory.Droid.SessionState
    Factory.Droid.Stream
    Factory.Droid.Schema.Automation
    Factory.Droid.Schema.Content
    Factory.Droid.Schema.Configuration
    Factory.Droid.Schema.Context
    Factory.Droid.Schema.Control
    Factory.Droid.Schema.Daemon.Automation
    Factory.Droid.Schema.Daemon.Cron
    Factory.Droid.Schema.Daemon.Git
    Factory.Droid.Schema.Daemon.Management
    Factory.Droid.Schema.Daemon.Plugin
    Factory.Droid.Schema.Daemon.Session
    Factory.Droid.Schema.Daemon.Settings
    Factory.Droid.Schema.Daemon.SoftwareFactory
    Factory.Droid.Schema.Daemon.Terminal
    Factory.Droid.Schema.Daemon.Workspace
    Factory.Droid.Schema.Daemon.Worktree
    Factory.Droid.Schema.Discovery
    Factory.Droid.Schema.Enums
    Factory.Droid.Schema.Host
    Factory.Droid.Schema.Interaction
    Factory.Droid.Schema.Local
    Factory.Droid.Schema.Loop
    Factory.Droid.Schema.MCP
    Factory.Droid.Schema.MCP.Config
    Factory.Droid.Schema.Messages
    Factory.Droid.Schema.Metadata
    Factory.Droid.Schema.Mission
    Factory.Droid.Schema.Models
    Factory.Droid.Schema.Notifications
    Factory.Droid.Schema.Primitives
    Factory.Droid.Schema.RPC
    Factory.Droid.Schema.REST
    Factory.Droid.Schema.Script
    Factory.Droid.Schema.Session
    Factory.Droid.Schema.Settings
    Factory.Droid.Schema.Sources
    Factory.Droid.Schema.SystemPrompt
    Factory.Droid.Schema.Tools
    Factory.Droid.Schema.Usage
    Factory.Droid.Transport
    Factory.Droid.Transport.InProcess
    Factory.Droid.Transport.IPC
    Factory.Droid.Transport.Process
